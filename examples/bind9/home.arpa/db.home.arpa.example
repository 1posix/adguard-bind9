$TTL 3600

@   IN  SOA ns1.home.arpa. hostmaster.home.arpa. (
        2026081301 ; serial YYYYMMDDNN
        3600       ; refresh
        900        ; retry
        604800     ; expire
        300        ; negative cache TTL
)

    IN  NS  ns1.home.arpa.

; ---------------------------------------------------------------------------
; Generic example records
; Replace these names and addresses with your own network.
; ---------------------------------------------------------------------------

ns1         IN  A   192.168.1.2

gateway     IN  A   192.168.1.1
dns         IN  A   192.168.1.2
server      IN  A   192.168.1.10
nas         IN  A   192.168.1.20
printer     IN  A   192.168.1.30
client      IN  A   192.168.1.100

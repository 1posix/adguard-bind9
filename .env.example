# Copy this file to .env before the first start.
# Use an IPv4 address that is actually configured on the Debian host.

TZ=Europe/Paris

# Address used by LAN/VLAN clients for DNS.
DNS_BIND_IP=192.168.1.10

# Address on which the AdGuard administration UI is published.
# This may be the same as DNS_BIND_IP or a dedicated management IP.
WEB_BIND_IP=192.168.1.10

# Host-side web ports. Inside the container the production UI stays on 80
# and the first-run wizard stays on 3000.
ADGUARD_WEB_PORT=80
ADGUARD_SETUP_PORT=3000

# Pinned/stable image tracks.
ADGUARD_IMAGE=adguard/adguardhome:v0.107.78
BIND_IMAGE=ubuntu/bind9:9.20-26.04_stable

# Resource guards. Increase AdGuard's limit if you use very large blocklists.
ADGUARD_MEM_LIMIT=1024m
ADGUARD_MEM_RESERVATION=128m
BIND_MEM_LIMIT=512m
BIND_MEM_RESERVATION=128m
